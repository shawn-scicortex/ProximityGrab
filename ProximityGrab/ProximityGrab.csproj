<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyToMods Condition="'$(CopyToMods)'==''">false</CopyToMods>
    <Version>0.10.1</Version>
    <Product>ProximityGrab</Product>
    <RootNamespace>ProximityGrab</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ResonitePath)'==''">
    <ResonitePath>$(MSBuildThisFileDirectory)Resonite/</ResonitePath>
    <ResonitePath Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\Resonite\')">C:\Program Files (x86)\Steam\steamapps\common\Resonite\</ResonitePath>
    <ResonitePath Condition="Exists('$(HOME)/.steam/steam/steamapps/common/Resonite/')">$(HOME)/.steam/steam/steamapps/common/Resonite/</ResonitePath>
  </PropertyGroup>

  <Target Name="DebugResonitePath" BeforeTargets="Build">
    <Message Text="ResonitePath = '$(ResonitePath)'" Importance="high" />
  </Target>

  <ItemGroup>
    <PackageReference Include="ResoniteModLoader" Version="5.0.1" />
    <PackageReference Include="Lib.Harmony" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FrooxEngine">
      <HintPath>$(ResonitePath)FrooxEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Elements.Core">
      <HintPath>$(ResonitePath)Elements.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Elements.Assets">
      <HintPath>$(ResonitePath)Elements.Assets.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Renderite.Shared">
      <HintPath>$(ResonitePath)Renderite.Shared.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SkyFrost.Base">
      <HintPath>$(ResonitePath)SkyFrost.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(CopyToMods)'=='true'">
    <Message Text="Copying ProximityGrab.dll to $(ResonitePath)rml_mods" Importance="high" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(ResonitePath)rml_mods" ContinueOnError="true" />
  </Target>

  <!-- Release zip: dotnet build -c Release -p:Dist=true
       (opt-in like CopyToMods so plain dev builds never zip) -->
  <Target Name="Dist" AfterTargets="Build" Condition="'$(Dist)'=='true'">
    <PropertyGroup>
      <DistStageDir>$(IntermediateOutputPath)dist-stage/</DistStageDir>
      <DistZip>$(MSBuildProjectDirectory)/../dist/ProximityGrab-$(Version).zip</DistZip>
    </PropertyGroup>
    <ItemGroup>
      <DistRootFiles Include="$(TargetPath)" />
      <DistRootFiles Include="$(MSBuildProjectDirectory)/../README.md" />
      <DistSrcFiles Include="$(MSBuildProjectDirectory)/*.cs;$(MSBuildProjectDirectory)/*.csproj" />
    </ItemGroup>
    <Copy SourceFiles="@(DistRootFiles)" DestinationFolder="$(DistStageDir)" />
    <Copy SourceFiles="@(DistSrcFiles)" DestinationFolder="$(DistStageDir)src/" />
    <MakeDir Directories="$(MSBuildProjectDirectory)/../dist" />
    <ZipDirectory SourceDirectory="$(DistStageDir)" DestinationFile="$(DistZip)" Overwrite="true" />
    <RemoveDir Directories="$(DistStageDir)" />
    <Message Text="Release zip: $(DistZip)" Importance="high" />
  </Target>
</Project>